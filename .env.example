# Copy this file to .env.local and fill in your own values.

# The password used to sign in to the app.
APP_PASSWORD=change-me-to-something-only-you-know

# Secret used to sign session cookies. Set to a long random string in production.
APP_SECRET=a-long-random-string

# Only set this to false if serving over plain HTTP (e.g. local testing).
# Leave unset for any real deployment.
# COOKIE_SECURE=false
